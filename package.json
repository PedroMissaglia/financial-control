{
  "name": "fin-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n mf-tx,mf-dash,host \"npm run dev:mf-transacoes\" \"npm run dev:mf-dashboard\" \"npm run dev:next\"",
    "kill:front": "node scripts/kill-front-ports.mjs",
    "dev:host": "node scripts/wait-for-remotes.mjs && npm run dev:next",
    "dev:next": "next dev",
    "dev:mf-transacoes": "npm --prefix mf-transacoes start",
    "dev:mf-dashboard": "npm --prefix mf-dashboard run dev",
    "build": "next build",
    "build:mf-transacoes": "npm --prefix mf-transacoes run build",
    "build:mf-dashboard": "npm --prefix mf-dashboard run build",
    "build:mfes": "concurrently -n mf-tx,mf-dash \"npm run build:mf-transacoes\" \"npm run build:mf-dashboard\"",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-module-shims": "^2.8.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
