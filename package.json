{
  "name": "fin-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n mf-tx,mf-dash,host \"npm run dev:mf-transacoes\" \"npm run dev:mf-dashboard\" \"npm run dev:next\"",
    "kill:front": "node scripts/kill-front-ports.mjs",
    "dev:api-mock": "concurrently -n api,mf-tx,mf-dash,host \"npm run dev:api\" \"npm run dev:mf-transacoes\" \"npm run dev:mf-dashboard\" \"npm run dev:host\"",
    "dev:host": "node scripts/wait-for-remotes.mjs && npm run dev:next",
    "dev:next": "next dev",
    "dev:api": "npx json-server --watch db.json --host ::1 --port 3001",
    "dev:mf-transacoes": "npm --prefix mf-transacoes start",
    "dev:mf-dashboard": "npm --prefix mf-dashboard run dev",
    "build": "next build",
    "build:mf-transacoes": "npm --prefix mf-transacoes run build",
    "build:mf-dashboard": "npm --prefix mf-dashboard run build",
    "build:mfes": "concurrently -n mf-tx,mf-dash \"npm run build:mf-transacoes\" \"npm run build:mf-dashboard\"",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-module-shims": "^2.8.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "^3.3.5",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-onboarding": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/nextjs": "^10.4.2",
    "@storybook/nextjs-vite": "^10.4.2",
    "@storybook/react": "^10.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-storybook": "^10.4.2",
    "json-server": "^0.17.4",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
