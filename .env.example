# API Nest local (não sobe com npm run dev). Default do host: 127.0.0.1:3001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
API_URL=http://127.0.0.1:3001

NEXT_PUBLIC_MF_TRANSACOES_URL=http://localhost:4200

NEXT_PUBLIC_MF_DASHBOARD_URL=http://localhost:4300

# Produção (Vercel): URLs HTTPS sem barra no final.
# NEXT_PUBLIC_* e VITE_API_URL entram no bundle no build — depois de mudar, faça Redeploy.
